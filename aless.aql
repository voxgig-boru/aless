# aless — an aql file viewer (jless-style), with tabs and file watching.
#
# Launch from the repo root:
#   aql aless.aql                # welcome tab; open files with :open
#
# On an aql with the IO.args word (proposals/script-argv-and-env.md),
# files can be passed straight from the shell:
#   aql aless.aql notes.json data.csv
# On builds without it, IO.args is absent and this falls back to the
# welcome tab (open files with :open, or use the -e form):
#   aql -e 'import "./aless-app.aql"  Aless.run {files: ["test/fixtures/sample.json"]}'
#
# Full keymap: press ? inside, or see README.md.

import "boru:io"
import "./aless-app.aql"

def _cli-files (do [ IO.args ] error [ drop [] ])

# Bind the final state so it does not auto-print after quit.
def _final (Aless.run {files: (_cli-files)})
