# aless — a boru file viewer (jless-style), with tabs and file watching.
#
# Launch (from any directory — the launcher's own imports resolve against
# this file's directory; file arguments resolve against the working
# directory, like any CLI):
#   boru aless.aql                    # welcome tab; open files with :open
#   boru aless.aql notes.json data.csv
#
# Files arrive through IO.args (proposals/script-argv-and-env.md, now on
# boru main). The `do … error` guard keeps the launcher usable on a host
# that runs it without argv: it falls back to the welcome tab.
#
# Full keymap: press ? inside, or see README.md.

import "boru:io"
import "./aless-app.aql"

def _cli-files (do [ IO.args ] error [ drop [] ])

# Bind the final state so it does not auto-print after quit.
def _final (Aless.run {files: (_cli-files)})
