# aless viewer: headless integration tests for the shell (aless-app.aql)
# — boot, command mode, quit, help, render.
#
# Drives the REAL update loop through Aless.feed — the same fold Tui.run
# applies to terminal events — with synthetic event maps, so the shell is
# exercised without a terminal. (boru has no boru-reachable virtual
# terminal backend; this is the next best surface — only rendering and
# raw key decoding stay untested here, covered by the PTY smoke in
# README.md.)
#
# The headless app tests are split across three suites —
#   aless_app_unit_test.aql          boot, command mode, quit, help, render
#   aless_app_browse_unit_test.aql   navigation, tab switching, search, yank
#   aless_app_watch_unit_test.aql    the watch-reload pipeline, manual reload
# — and feed key sequences through one fold (_keys, _line), with the
# common starting states built once (_booted, _json).
# works around boru compile defect: the compile pass runs the top level
# under check-mode analysis with a fixed 500,000-step budget and every
# Aless.feed costs a full analysis of the update loop (twice inside a
# Test.test body), so one suite holding all fourteen scenarios exhausted
# the budget and then failed with the misattributed "[boru/compile_failed]
# unmatched dispatch recovered at def" (dx-report, "Migration to boru
# main") — remove the split when fixed upstream.
#
# Run from the repo root (the fixtures resolve against the working
# directory):
#   boru test/aless_app_unit_test.aql


import "boru:test" end
import "boru:string-util" end
import "../aless-app.aql" end
import "../aless-tabs.aql" end
import "../aless-view.aql" end


# Type a string into the app, one key event per character.
def _type fn [
  [st:Map s:String] [Map] [
    fold [ var [[j acc]
      def c (slice (j) ((j) add 1) s)
      Aless.feed (acc) {tag: "key", key: (c), char: (c)}
    ]] (range 0 (size (s)) 1) (st)
  ]
]

# Press one named key.
def _key fn [
  [st:Map k:String] [Map] [
    Aless.feed (st) {tag: "key", key: (k)}
  ]
]

# Submit one mode line: the lead key (":" or "/"), the text typed one
# character at a time (as _type), then enter — the same events as
# `_key (_type (_key st lead) s) "enter"`, folded in one pass.
def _line fn [
  [st:Map lead:String s:String] [Map] [
    def n (size (s))
    fold [ var [[j acc]
      def ev (if ((j) eq 0) [ {tag: "key", key: (lead)} ] [
        if ((j) gt (n)) [ {tag: "key", key: "enter"} ] [
          def c (slice ((j) sub 1) (j) s)
          {tag: "key", key: (c), char: (c)}
        ]
      ])
      Aless.feed (acc) (ev)
    ]] (range 0 ((n) add 2) 1) (st)
  ]
]

# Boot an app on the welcome tab at 100x30.
def _boot fn [
  [] [Map] [
    def app (Aless.app {})
    Aless.feed (app get "init") {tag: "init", cols: 100, rows: 30}
  ]
]

# Shared starting states, built once at top level: the booted app on its
# welcome tab, and the app after `:open test/fixtures/sample.json`. App
# states are immutable maps, so a test that starts from one sees exactly
# the state it would rebuild with its own _boot / :open.
def _booted (_boot)
def _json (_line (_booted) ":" "open test/fixtures/sample.json")


# --- boot: welcome tab, browse mode ---------------------------------

[
  def st (_booted)
  1 (size (st get "tabs")) Assert.equal end
  "browse" (st get "mode") Assert.equal end
  "(welcome)" ((AlessTabs.active (st)) get "path") Assert.equal end
] "boot-welcome" Test.test end


# --- command mode: :open loads a tab, watching by default ------------

[
  def st (_booted)
  def st2 (_key (st) ":")
  "command" (st2 get "mode") Assert.equal end
  def st3 (_type (st2) "open test/fixtures/sample.json")
  def st4 (_key (st3) "enter")
  "browse" (st4 get "mode") Assert.equal end
  2 (size (st4 get "tabs")) Assert.equal end
  1 (st4 get "active") Assert.equal end
  def tb (AlessTabs.active (st4))
  "json" (tb get "kind") Assert.equal end
  true (tb get "watch") Assert.equal end
  3 (size (tb get "rows")) Assert.equal end
] "open-command-watches" Test.test end


# --- unknown command reports, bad path keeps a tab -------------------

[
  def st (_booted)
  def st2 (_line (st) ":" "frobnicate")
  "unknown command: frobnicate" (st2 get "msg") Assert.equal end
  def st3 (_line (st2) ":" "open no/such/file.json")
  2 (size (st3 get "tabs")) Assert.equal end
  # a failed open still watches: the tab reloads if the file appears
  true ((AlessTabs.active (st3)) get "watch") Assert.equal end
] "command-errors" Test.test end


# --- q closes tabs; the last q yields the quit marker ----------------

[
  def st2 (_json)
  def st3 (_key (st2) "q")
  1 (size (st3 get "tabs")) Assert.equal end
  "(welcome)" ((AlessTabs.active (st3)) get "path") Assert.equal end
] "q-closes-tab" Test.test end


# --- help overlay ----------------------------------------------------

[
  def st (_booted)
  def st2 (_key (st) "?")
  "help" (st2 get "mode") Assert.equal end
  def st3 (_key (st2) "j")
  "browse" (st3 get "mode") Assert.equal end
] "help-overlay" Test.test end


# --- the view renders every mode (widget trees are plain data) ------

[
  def st (_booted)
  def wb (convert String (canon (AlessView.render (st))))
  true (StringUtil.contains "aql file viewer" (wb)) Assert.equal end
  def wh (convert String (canon (AlessView.render ((st) set mode "help"))))
  true (StringUtil.contains "move focus" (wh)) Assert.equal end
  true (StringUtil.contains "any key returns" (wh)) Assert.equal end
  def st2 (_json)
  def wt (convert String (canon (AlessView.render (st2))))
  true (StringUtil.contains "store" (wt)) Assert.equal end
  true (StringUtil.contains "sample.json" (wt)) Assert.equal end
  def wc (convert String (canon (AlessView.render ((st2) set mode "command"))))
  true (StringUtil.contains "input" (wc)) Assert.equal end
] "render-all-modes" Test.test end


# --- summary --------------------------------------------------------

print "---"
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print "all green"
