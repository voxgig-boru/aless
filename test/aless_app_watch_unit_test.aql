# aless viewer: headless integration tests for the shell (aless-app.aql)
# — the watch-reload pipeline and manual reload.
#
# Drives the REAL update loop through Aless.feed — the same fold Tui.run
# applies to terminal events — with synthetic event maps, so the shell is
# exercised without a terminal. (boru has no boru-reachable virtual
# terminal backend; this is the next best surface — only rendering and
# raw key decoding stay untested here, covered by the PTY smoke in
# README.md.)
#
# The headless app tests are split across three suites —
#   aless_app_unit_test.aql          boot, command mode, quit, help, render
#   aless_app_browse_unit_test.aql   navigation, tab switching, search, yank
#   aless_app_watch_unit_test.aql    the watch-reload pipeline, manual reload
# — and feed key sequences through one fold (_keys, _line), with the
# common starting states built once (_booted, _json).
# works around boru compile defect: the compile pass runs the top level
# under check-mode analysis with a fixed 500,000-step budget and every
# Aless.feed costs a full analysis of the update loop (twice inside a
# Test.test body), so one suite holding all fourteen scenarios exhausted
# the budget and then failed with the misattributed "[boru/compile_failed]
# unmatched dispatch recovered at def" (dx-report, "Migration to boru
# main") — remove the split when fixed upstream.
#
# Run from the repo root (the fixtures resolve against the working
# directory):
#   boru test/aless_app_watch_unit_test.aql


import "boru:test" end
import "boru:io" end
import "../aless-app.aql" end
import "../aless-tabs.aql" end


def _tmp-path "test/fixtures/.tmp-aless-app-watch.json"

# Press one named key.
def _key fn [
  [st:Map k:String] [Map] [
    Aless.feed (st) {tag: "key", key: (k)}
  ]
]

# Press named keys in order — one key event each, exactly as successive
# _key calls, folded through Aless.feed in one pass.
def _keys fn [
  [st:Map ks:List] [Map] [
    fold [ var [[k acc] Aless.feed (acc) {tag: "key", key: (k)} ]] (ks) (st)
  ]
]

# Submit one mode line: the lead key (":" or "/"), the text typed one
# character at a time (as _type), then enter — the same events as
# `_key (_type (_key st lead) s) "enter"`, folded in one pass.
def _line fn [
  [st:Map lead:String s:String] [Map] [
    def n (size (s))
    fold [ var [[j acc]
      def ev (if ((j) eq 0) [ {tag: "key", key: (lead)} ] [
        if ((j) gt (n)) [ {tag: "key", key: "enter"} ] [
          def c (slice ((j) sub 1) (j) s)
          {tag: "key", key: (c), char: (c)}
        ]
      ])
      Aless.feed (acc) (ev)
    ]] (range 0 ((n) add 2) 1) (st)
  ]
]

# Boot an app on the welcome tab at 100x30.
def _boot fn [
  [] [Map] [
    def app (Aless.app {})
    Aless.feed (app get "init") {tag: "init", cols: 100, rows: 30}
  ]
]

# Shared starting state, built once at top level: the booted app on its
# welcome tab. App states are immutable maps, so a test that starts from
# it sees exactly the state it would rebuild with its own _boot.
def _booted (_boot)


# --- watch pipeline: on-disk change + file-changed event -------------
#
# The real fs write happens between two feeds; the synthetic
# {tag: "file-changed"} stands in for the IO.watch delivery (the
# fsnotify hop itself is asynchronous and pinned upstream).

[
  IO.write (make Pathon (_tmp-path)) "{a: {b: 1}, c: [10, 20]}" end drop
  def st (_booted)
  def st2 (_line (st) ":" `open ${_tmp-path} jsonic`)
  def tb (AlessTabs.active (st2))
  true (tb get "watch") Assert.equal end
  # focus .c, expand it, focus .c[1]
  def st3 (_keys (st2) ["j" "J" "l" "j" "j"])
  def tb3 (AlessTabs.active (st3))
  "c" (((tb3 get "rows") get 2) get "key") Assert.equal end
  4 (tb3 get "focus") Assert.equal end
  # change the file on disk, then deliver the change event
  IO.write (make Pathon (_tmp-path)) "{a: {b: 99}, c: [10, 21]}" end drop
  def st4 (Aless.feed (st3) {tag: "file-changed", op: "write"})
  def tb4 (AlessTabs.active (st4))
  # document reloaded…
  21 ((((tb4 get "doc") get "c") get 1)) Assert.equal end
  # …and the view position survived: same focused path, same screen line
  true ((((tb4 get "rows") get (tb4 get "focus")) get "path") deq ["c", 1]) Assert.equal end
  ((tb3 get "focus") sub (tb3 get "scroll"))
    ((tb4 get "focus") sub (tb4 get "scroll")) Assert.equal end
  true ((tb4 get "err") is None) Assert.equal end
  1 (tb4 get "gen") Assert.equal end
] "watch-reload-retains-position" Test.test end


# --- watch reload: broken syntax keeps the old view ------------------

[
  IO.write (make Pathon (_tmp-path)) "{a: 1}" end drop
  def st (_booted)
  def st2 (_line (st) ":" `open ${_tmp-path} json`)
  def tb2 (AlessTabs.active (st2))
  # remove the file: reload fails, view survives, tab marked gone
  IO.remove (make Pathon (_tmp-path)) end drop
  def st3 (Aless.feed (st2) {tag: "file-changed", op: "remove"})
  def tb3 (AlessTabs.active (st3))
  true ((tb3 get "rows") deq (tb2 get "rows")) Assert.equal end
  false ((tb3 get "err") is None) Assert.equal end
  true (tb3 get "gone") Assert.equal end
] "watch-gone-keeps-view" Test.test end


# --- W toggles, :watch off stops -------------------------------------

[
  IO.write (make Pathon (_tmp-path)) "{a: 1}" end drop
  def st (_booted)
  def st2 (_line (st) ":" `open ${_tmp-path}`)
  true ((AlessTabs.active (st2)) get "watch") Assert.equal end
  def st3 (_key (st2) "W")
  false ((AlessTabs.active (st3)) get "watch") Assert.equal end
  def st4 (_key (st3) "W")
  true ((AlessTabs.active (st4)) get "watch") Assert.equal end
  def st5 (_line (st4) ":" "watch off")
  false ((AlessTabs.active (st5)) get "watch") Assert.equal end
  IO.remove (make Pathon (_tmp-path)) end drop
] "watch-toggles" Test.test end


# --- r on the welcome tab is a no-op (no false gone/err) -------------
#
# The welcome tab has no file behind it, so a manual reload must not
# try to load its synthetic "(welcome)" path and falsely mark it gone.

[
  def st (_booted)
  def st2 (_key (st) "r")
  def tb (AlessTabs.active (st2))
  "(welcome)" (tb get "path") Assert.equal end
  false (tb get "gone") Assert.equal end
  true ((tb get "err") is None) Assert.equal end
  true ((tb get "rows") deq ((AlessTabs.active (st)) get "rows")) Assert.equal end
] "welcome-reload-noop" Test.test end


# --- summary --------------------------------------------------------

print "---"
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print "all green"
