# aless viewer: unit tests for aless-nav.aql (the jless keymap fold).
#
# Run from the repo root:
#   aql test/aless_nav_unit_test.aql


import "boru:test" end
import "../aless-doc.aql" end
import "../aless-nav.aql" end


def _doc {a: {b: {c: [1, 2]}, d: true}, e: "s", f: [10, 20, 30]}

# A fresh single-tab view state over _doc: rows = root + one level
# (root, a, e, f), focus at the root, 5-row window.
def _mk fn [
  [] [Map] [
    def rows (AlessDoc.top (_doc))
    def out {doc: (_doc), rows: (rows), focus: 0, scroll: 0, xoff: 0, pending: ""}
    out
  ]
]

def _vh 5


# --- vertical movement ----------------------------------------------

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  1 (t1 get "focus") Assert.equal end
  0 (t1 get "scroll") Assert.equal end
  def t2 (AlessNav.key (t1) {key: "down"} (_vh))
  def t3 (AlessNav.key (t2) {key: "k"} (_vh))
  1 (t3 get "focus") Assert.equal end
  def t4 (AlessNav.key (t3) {key: "up"} (_vh))
  def t5 (AlessNav.key (t4) {key: "up"} (_vh))
  0 (t5 get "focus") Assert.equal end
] "focus-up-down-clamps" Test.test end

[
  def t1 (AlessNav.key (_mk) {key: "G"} (_vh))
  3 (t1 get "focus") Assert.equal end
  def t2 (AlessNav.key (t1) {key: "g"} (_vh))
  0 (t2 get "focus") Assert.equal end
  0 (t2 get "scroll") Assert.equal end
] "first-last-row" Test.test end


# --- expand / step in / collapse / step out -------------------------

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  def t2 (AlessNav.key (t1) {key: "l"} (_vh))
  6 (size (t2 get "rows")) Assert.equal end
  1 (t2 get "focus") Assert.equal end
  true (((t2 get "rows") get 1) get "open") Assert.equal end
  def t3 (AlessNav.key (t2) {key: "l"} (_vh))
  2 (t3 get "focus") Assert.equal end
  "b" (((t3 get "rows") get 2) get "key") Assert.equal end
] "expand-then-step-in" Test.test end

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  def t2 (AlessNav.key (t1) {key: "l"} (_vh))
  def t3 (AlessNav.key (t2) {key: "l"} (_vh))
  def t4 (AlessNav.key (t3) {key: "h"} (_vh))
  1 (t4 get "focus") Assert.equal end
  6 (size (t4 get "rows")) Assert.equal end
  def t5 (AlessNav.key (t4) {key: "h"} (_vh))
  4 (size (t5 get "rows")) Assert.equal end
  false (((t5 get "rows") get 1) get "open") Assert.equal end
] "step-out-then-collapse" Test.test end

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  def t2 (AlessNav.key (t1) {key: "space"} (_vh))
  6 (size (t2 get "rows")) Assert.equal end
  def t3 (AlessNav.key (t2) {key: "space"} (_vh))
  4 (size (t3 get "rows")) Assert.equal end
  true ((t3 get "rows") deq (t1 get "rows")) Assert.equal end
] "space-toggles" Test.test end


# --- siblings and depth moves ---------------------------------------

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  def t2 (AlessNav.key (t1) {key: "J"} (_vh))
  2 (t2 get "focus") Assert.equal end
  def t3 (AlessNav.key (t2) {key: "K"} (_vh))
  1 (t3 get "focus") Assert.equal end
  def t4 (AlessNav.key (t3) {key: "K"} (_vh))
  1 (t4 get "focus") Assert.equal end
] "sibling-moves" Test.test end

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  def t2 (AlessNav.key (t1) {key: "l"} (_vh))
  def t3 (AlessNav.key (t2) {key: "l"} (_vh))
  def t4 (AlessNav.key (t3) {key: "H"} (_vh))
  1 (t4 get "focus") Assert.equal end
  6 (size (t4 get "rows")) Assert.equal end
] "H-parent-no-collapse" Test.test end

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  def t2 (AlessNav.key (t1) {key: "l"} (_vh))
  def t3 (AlessNav.key (t2) {key: "w"} (_vh))
  2 (t3 get "focus") Assert.equal end
  def t4 (AlessNav.key (t3) {key: "b"} (_vh))
  1 (t4 get "focus") Assert.equal end
] "depth-change-moves" Test.test end

[
  def t1 (AlessNav.key (_mk) {key: "j"} (_vh))
  def t2 (AlessNav.key (t1) {key: "J"} (_vh))
  def t3 (AlessNav.key (t2) {key: "0"} (_vh))
  1 (t3 get "focus") Assert.equal end
  def t4 (AlessNav.key (t3) {key: "$"} (_vh))
  3 (t4 get "focus") Assert.equal end
] "first-last-sibling" Test.test end


# --- deep expand ----------------------------------------------------

[
  def t1 (AlessNav.key (_mk) {key: "E"} (_vh))
  12 (size (t1 get "rows")) Assert.equal end
] "deep-expand-all" Test.test end

# A single container wider than the 5000-row cap must not be expanded in
# one step: E rejects the expansion and the rows stay put.
def _wide {items: (iota 6000)}
[
  def rows (AlessDoc.top (_wide))
  def st {doc: (_wide), rows: (rows), focus: 0, scroll: 0, xoff: 0, pending: ""}
  2 (size (st get "rows")) Assert.equal end
  def t1 (AlessNav.key (st) {key: "E"} (_vh))
  2 (size (t1 get "rows")) Assert.equal end
  false (((t1 get "rows") get 1) get "open") Assert.equal end
] "deep-expand-respects-row-cap" Test.test end


# --- paging and scrolling -------------------------------------------

[
  def t0 (AlessNav.key (_mk) {key: "E"} (_vh))
  def t1 (AlessNav.key (t0) {key: "f", mods: ["ctrl"]} (_vh))
  5 (t1 get "focus") Assert.equal end
  1 (t1 get "scroll") Assert.equal end
  def t2 (AlessNav.key (t1) {key: "d", mods: ["ctrl"]} (_vh))
  7 (t2 get "focus") Assert.equal end
  def t3 (AlessNav.key (t2) {key: "b", mods: ["ctrl"]} (_vh))
  2 (t3 get "focus") Assert.equal end
] "paging" Test.test end

[
  def t0 (AlessNav.key (_mk) {key: "E"} (_vh))
  def t1 (AlessNav.key (t0) {key: "e", mods: ["ctrl"]} (_vh))
  1 (t1 get "scroll") Assert.equal end
  1 (t1 get "focus") Assert.equal end
  def t2 (AlessNav.key (t1) {key: "y", mods: ["ctrl"]} (_vh))
  0 (t2 get "scroll") Assert.equal end
] "scroll-only" Test.test end

[
  def t0 (AlessNav.key (_mk) {key: "E"} (_vh))
  def t1 (AlessNav.key (t0) {key: "f", mods: ["ctrl"]} (_vh))
  5 (t1 get "focus") Assert.equal end
  def t2 (AlessNav.key (t1) {key: "z"} (_vh))
  "z" (t2 get "pending") Assert.equal end
  def t3 (AlessNav.key (t2) {key: "t"} (_vh))
  "" (t3 get "pending") Assert.equal end
  5 (t3 get "scroll") Assert.equal end
  def t4 (AlessNav.key ((t3) set pending "z") {key: "z"} (_vh))
  3 (t4 get "scroll") Assert.equal end
  def t5 (AlessNav.key ((t4) set pending "z") {key: "b"} (_vh))
  1 (t5 get "scroll") Assert.equal end
] "z-reposition" Test.test end


# --- horizontal offset ----------------------------------------------

[
  def t1 (AlessNav.key (_mk) {key: "."} (_vh))
  8 (t1 get "xoff") Assert.equal end
  def t2 (AlessNav.key (t1) {key: ","} (_vh))
  0 (t2 get "xoff") Assert.equal end
  def t3 (AlessNav.key (t2) {key: ","} (_vh))
  0 (t3 get "xoff") Assert.equal end
] "xoff" Test.test end


# --- unknown keys are inert -----------------------------------------

[
  def t0 (_mk)
  def t1 (AlessNav.key (t0) {key: "q"} (_vh))
  true ((t1) deq (t0)) Assert.equal end
  def t2 (AlessNav.key (t0) {resize: true} (_vh))
  true ((t2) deq (t0)) Assert.equal end
] "unknown-keys-inert" Test.test end


# --- index-of -------------------------------------------------------

[
  def t0 (_mk)
  1 (AlessNav.index-of (t0) ["a"]) Assert.equal end
  0 (AlessNav.index-of (t0) []) Assert.equal end
  -1 (AlessNav.index-of (t0) ["a", "b"]) Assert.equal end
] "index-of" Test.test end


# --- summary --------------------------------------------------------

print "---"
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print "all green"
